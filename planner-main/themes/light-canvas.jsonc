{
    "name": "Light Canvas",
    "type": "canvas",
    "labelFont": "Noto Sans", // Canvas label font family name, not a font filename.
    "colors": {
        // Colors use #RRGGBB or #AARRGGBB (alpha first).

        // Canvas and object colors
        "canvas": "#ffffff", // Canvas background and furnishing artwork background.
        "grid": "#000000", // Grid ink; brightness also follows grid intensity settings.
        "objectOutline": "#343c42", // Object and furnishing outlines, canvas label text, and visible tree entries.
        "wallOutline": "#59636b", // Wall and pillar outlines.
        "wallFill": "#e5e8ea", // Wall and pillar fill.
        "materialPattern": "#929ca4", // Material hatch and pattern ink.

        // Canvas selection
        "selectionOutline": "#1673c9", // Selected object outlines and control handles.
        "selectionFill": "#d3e6f6", // Selected wall and pillar fill.
        "groupSelectionOutline": "#6553b5", // Grouped selection outlines and handles.
        "groupSelectionFill": "#e3dcf5", // Grouped wall and pillar selection fill.
        "stairSelectionFill": "#e4f0fa", // Selected stair fill.
        "stairGroupSelectionFill": "#eee9f8", // Grouped stair selection fill.
        "selectionBoxFill": "#2372b8ff", // Translucent box-selection fill.

        // Measurements and rulers
        "measurementLine": "#687783", // Dimension lines, ticks, and extension lines.
        "rulerBackground": "#e6e6e6", // Viewport ruler background.
        "rulerMajorTick": "#727b83", // Major ruler ticks.
        "rulerMinorTick": "#a2a9af", // Minor ruler ticks.
        "rulerText": "#424c55", // Ruler numbers, unit labels, and canvas measurement readouts.

        // Canvas overlays and feedback
        "overlayFill": "#e6ffffff", // Background behind canvas tooltips and readouts.
        "exportOutsideShade": "#41000000", // Translucent dimming outside the export bounds in the viewport preview.
        "performanceText": "#d02020", // FPS and rendering performance readout.
        "invalidOutline": "#8d969d", // Placement previews and invalid geometry outlines.
        "warningFill": "#f5dada", // Fill for collision or invalid-placement warnings.
        "warningOutline": "#c92d35", // Collision and invalid-placement warning outlines.
        "errorBorder": "#c46b6b", // Viewport error-message border.
        "errorFill": "#f0ffe8e8", // Viewport error-message background.
        "errorText": "#ad2222", // Viewport error-message text.

        // Missing furnishing artwork
        "missing": "#d02020" // Placeholder ink for missing furnishing artwork.
    }
}
