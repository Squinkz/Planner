{
    "name": "Light UI",
    "type": "ui",
    "colors": {
        // Colors use #RRGGBB or #AARRGGBB (alpha first).

        // Text colors
        "text": "#202020", // UI text and widget labels; canvas labels use objectOutline.
        "mutedText": "#666666", // Secondary UI text, placeholders, and shortcut hints.
        "activeText": "#111111", // Text on active or highlighted UI controls.
        "disabled": "#777777", // Disabled UI text and control paint.
        "treeDisabledText": "#999999", // Hidden entries in the visibility tree.
        "treeEmptyText": "#777777", // Visibility categories containing no objects.

        // UI surfaces and borders
        "windowBackground": "#f0f0f0", // Window and panel backgrounds.
        "controlBackground": "#e0e0e0", // Buttons, menus, dropdown arrow buttons, and ruler unit corners.
        "fieldBackground": "#e0e0e0", // Editable text, numeric fields, and dropdown values.
        "hoverBackground": "#d4d4d4", // Control background on mouse hover.
        "pressedBackground": "#c8c8c8", // Control background while pressed.
        "activeBackground": "#b3c8db", // Checked controls, menu selections, and input text selection.
        "activeHoverBackground": "#a2bdd4", // Selected controls on mouse hover.
        "disabledBackground": "#e8e8e8", // Disabled control backgrounds.
        "border": "#c4c4c4", // UI dividers, group-box borders, and the outer ruler frame.
        "menuBorder": "#b5b5b5", // Popup menu borders.

        // UI controls and icons
        "sliderHandle": "#555555", // Slider handles.
        "scrollbarHandle": "#b0b0b0", // Scrollbar handles.
        "icon": "#202020", // Normal UI icon paint.
        "iconDisabled": "#a0a0a0", // Disabled UI icon paint.
        "shadow": "#000000", // Shadow fills in the label and counter tool icons.

        // Dialog message icons and window icons
        "warning": "#946400", // Large warning icon inside message dialogs.
        "error": "#b92323", // Large error icon inside message dialogs.
        "info": "#176aa8", // Large information icon inside message dialogs.
        "warningTitle": "#946400", // Warning dialog window icon; does not color heading text.
        "errorTitle": "#b92323", // Error dialog window icon; does not color heading text.
        "infoTitle": "#176aa8" // Information dialog window icon; does not color heading text.
    }
}
