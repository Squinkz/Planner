// Deep navy blueprint paper with luminous ice-blue drafting lines.
{
    "name": "Deep Blueprint Canvas",
    "type": "canvas",
    "extends": "Blueprint Canvas",
    "colors": {
        "canvas": "#071b30",
        "roomFill": "#0d263a", // Background inside detected rooms in the editor.
        "grid": "#5788b0",
        "objectOutline": "#deefff",
        "wallOutline": "#e7f3ff",
        "wallFill": "#102d48",
        "materialPattern": "#638aaf",
        "selectionOutline": "#ffc3a0",
        "selectionFill": "#59434a",
        "groupSelectionOutline": "#e99a78",
        "groupSelectionFill": "#75494b",
        "stairSelectionFill": "#443842",
        "stairGroupSelectionFill": "#5a3c43",
        "selectionBoxFill": "#23ffc3a0",
        "measurementLine": "#92b7d6",
        "rulerBackground": "#061525",
        "rulerMajorTick": "#8eb3d0",
        "rulerMinorTick": "#446687",
        "rulerText": "#bfd9ef",
        "overlayFill": "#ed061525",
        "invalidOutline": "#638aaf"
    }
}
