// Neutral editor-inspired charcoal with silver linework and vivid gold selections.
{
    "name": "Charcoal Canvas",
    "type": "canvas",
    "extends": "Dark Canvas",
    "colors": {
        "canvas": "#252526",
        "roomFill": "#2d2d2e",
        "grid": "#7e7e80",
        "objectOutline": "#dedee0",
        "wallOutline": "#c2c2c5",
        "wallFill": "#38383a",
        "materialPattern": "#7c7c80",
        "selectionOutline": "#ffbf47",
        "selectionFill": "#62502d",
        "groupSelectionOutline": "#f28f43",
        "groupSelectionFill": "#73432b",
        "stairSelectionFill": "#4d4028",
        "stairGroupSelectionFill": "#593724",
        "selectionBoxFill": "#33ffbf47",
        "measurementLine": "#a2a2a6",
        "rulerBackground": "#202021",
        "rulerMajorTick": "#a0a0a4",
        "rulerMinorTick": "#606063",
        "rulerText": "#cbcbce",
        "overlayFill": "#ed202021",
        "performanceText": "#eea080",
        "invalidOutline": "#7c7c80",
        "warningFill": "#583c34",
        "warningOutline": "#f0a18c",
        "errorBorder": "#9a6259",
        "errorFill": "#f03e2c2c",
        "errorText": "#f4b2a6",
        "missing": "#eea080"
    }
}
